# Check if container exists and its state
function get_container_state() {
  local name="$1"
  if docker ps --format "{{.Names}}" --filter "name=${name}" 2>/dev/null | grep -q "^${name}$"; then
    echo "running"
  elif docker ps -a --format "{{.Names}}" --filter "name=${name}" 2>/dev/null | grep -q "^${name}$"; then
    echo "stopped"
  else
    echo "none"
  fi
}

function array_contains() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}


function resolve_oidc_callback_ports() {
  OIDC_CALLBACK_PORTS=()
  OIDC_LISTEN_ADDRESSES=()

  if [ -n "${OIDC_CALLBACK_PORT_CANDIDATES}" ]; then
    # Manual override via -O or MAPS_TOOLS_OIDC_CALLBACK_PORTS: validate and use as-is
    local normalized_candidates="${OIDC_CALLBACK_PORT_CANDIDATES//,/ }"
    local port
    for port in ${normalized_candidates}; do
      if [[ ! "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
        echo "❌ Invalid OIDC callback port: ${port}"
        echo "   Use an unprivileged TCP port in the range 1024-65535."
        exit 1
      fi

      array_contains "$port" "${OIDC_CALLBACK_PORTS[@]}" && continue

      if array_contains "$port" "${AVAILABLE_PORTS[@]}" || is_port_available "$port"; then
        OIDC_CALLBACK_PORTS+=("$port")
        OIDC_LISTEN_ADDRESSES+=("0.0.0.0:${port}")
      fi
    done

    if [ "${#OIDC_CALLBACK_PORTS[@]}" -eq 0 ]; then
      echo "❌ No configured OIDC callback port is available."
      echo "   Free one of these ports or provide registered alternatives with -O:"
      echo "   ${OIDC_CALLBACK_PORT_CANDIDATES}"
      echo "   Custom ports must be registered as Azure redirect URIs."
      exit 1
    fi
  else
    # Auto-discovery: find first free port in range 18000-18100
    local port
    for port in {18000..18100}; do
      if is_port_available "$port"; then
        OIDC_CALLBACK_PORTS+=("$port")
        OIDC_LISTEN_ADDRESSES+=("0.0.0.0:${port}")
        break
      fi
    done

    if [ "${#OIDC_CALLBACK_PORTS[@]}" -eq 0 ]; then
      echo "❌ No free OIDC callback port found in range 18000-18100."
      echo "   Free a port in that range or specify one explicitly with -O."
      echo "   Custom ports must be registered as Azure redirect URIs."
      exit 1
    fi
  fi
}

# Add volume mounts to docker command array
function add_volume_mounts() {
  DOCKER_CMD+=("-v" "$HOME:/home/$CURRENT_USER")
  
  if [ "${MOUNT_AWS_CONFIGS}" = "true" ]; then
    # Ensure required mount sources exist before Docker tries to bind them.
    # Docker Desktop may otherwise attempt to create them and fail with permission errors.
    [ ! -d "$HOME/.aws" ] && mkdir -p "$HOME/.aws"
    [ ! -d "$HOME/.ssh" ] && mkdir -m 700 "$HOME/.ssh"
    [ ! -d "$HOME/.helm" ] && mkdir -p "$HOME/.helm"
    [ ! -d "$HOME/.kube" ] && mkdir -p "$HOME/.kube"
    [ ! -d "$HOME/.spacelift" ] && mkdir -p "$HOME/.spacelift"
    [ ! -d "$HOME/.maps-tools" ] && mkdir -p "$HOME/.maps-tools"
    [ ! -f "$HOME/.terraformrc" ] && touch "$HOME/.terraformrc"

    DOCKER_CMD+=("-v" "$HOME/.aws:/home/$DEFAULT_DOCKER_USERNAME/.aws")
    DOCKER_CMD+=("-v" "$HOME/.ssh:/home/$DEFAULT_DOCKER_USERNAME/.ssh")
    DOCKER_CMD+=("-v" "$HOME/.helm:/home/$DEFAULT_DOCKER_USERNAME/.helm")
    DOCKER_CMD+=("-v" "$HOME/.kube:/home/$DEFAULT_DOCKER_USERNAME/.kube")
    DOCKER_CMD+=("-v" "$HOME/.spacelift:/home/$DEFAULT_DOCKER_USERNAME/.spacelift")
    DOCKER_CMD+=("-v" "$HOME/.maps-tools:/home/$DEFAULT_DOCKER_USERNAME/.maps-tools")
    DOCKER_CMD+=("-v" "$HOME/.terraformrc:/home/$DEFAULT_DOCKER_USERNAME/.terraformrc")
  fi
}

# Add port mappings to docker command array
function add_port_mappings() {
  for port in ${AVAILABLE_PORTS[@]}; do
    if ! array_contains "$port" "${OIDC_CALLBACK_PORTS[@]}"; then
      DOCKER_CMD+=("-p" "${port}:${port}")
    fi
  done

  for port in ${OIDC_CALLBACK_PORTS[@]}; do
    DOCKER_CMD+=("-p" "127.0.0.1:${port}:${port}")
  done
}

# Add environment variables to docker command array
function add_environment_vars() {
  local container_start_path="$PWD"
  if echo "$container_start_path" | grep -q "$HOME"; then
    container_start_path=$(echo "$container_start_path" | sed "s|Users|home|")
  else
    container_start_path="/home/$USER"
  fi
  
  DOCKER_CMD+=("-e" "AWS_PROFILE=$AWS_PROFILE_STAGE")
  DOCKER_CMD+=("-e" "DEFAULT_SESSION_KUBECONFIG=$USE_SESSION_KUBECONFIG")
  DOCKER_CMD+=("-e" "START_PATH=$container_start_path")
  DOCKER_CMD+=("-e" "K8S_DASHBOARD=$ENABLE_K8S_DASHBOARD")

  if [ ${#OIDC_LISTEN_ADDRESSES[@]} -gt 0 ]; then
    DOCKER_CMD+=("-e" "OIDC_LOGIN_LISTEN_ADDRESSES=${OIDC_LISTEN_ADDRESSES[*]}")
  fi
  
  if [ ${#AVAILABLE_PORTS[@]} -gt 0 ]; then
    DOCKER_CMD+=("-e" "PORT_VARIABLE=${AVAILABLE_PORTS[*]}")
  fi
  
  if [ "${ENABLE_K8S_DASHBOARD}" = "true" ]; then
    DOCKER_CMD+=("-e" "OCTANT_LISTENER_ADDR=0.0.0.0:7777")
    DOCKER_CMD+=("-p" "7777:7777")
  fi

  # Browser listener for OIDC login URL auto-open
  if [ -n "${MAPS_TOOLS_BROWSER_TOKEN}" ]; then
    DOCKER_CMD+=("-e" "MAPS_TOOLS_BROWSER_PORT=${BROWSER_LISTENER_PORT}")
    DOCKER_CMD+=("-e" "MAPS_TOOLS_BROWSER_TOKEN=${MAPS_TOOLS_BROWSER_TOKEN}")
  fi
}

# Build complete Docker command based on operation mode
function build_docker_command() {
  if [ $# -lt 1 ]; then
    echo "❌ No image name provided"
    return 1
  fi
  
  local image_name="$1"
  shift
  local command_to_exec="$*"
  local container_state=$(get_container_state "maps-tools")
  
  DOCKER_CMD=()
  
  # Build command based on operation mode
  if [ "${RUN_AS_DAEMON}" = "true" ]; then
    if [ "$container_state" != "none" ]; then
      docker rm -f maps-tools >/dev/null 2>&1
    fi
    resolve_oidc_callback_ports
    DOCKER_CMD=(docker create --name maps-tools)
    add_volume_mounts
    add_port_mappings
    add_environment_vars
    DOCKER_CMD+=("${EXTRA_DOCKER_ARGS[@]}")
    DOCKER_CMD+=(--entrypoint "/init/init_daemon.sh" "$image_name")
                
  elif [ "${ATTACH_TO_DAEMON}" = "true" ]; then
    if [ "$container_state" = "running" ]; then
      DOCKER_CMD=(docker exec -ti)
      # Only pass AWS_PROFILE if explicitly set — otherwise let bash_profile_aws
      # in the container restore the last used profile from awsctx.profile.current.
      [ -n "${AWS_PROFILE_STAGE}" ] && DOCKER_CMD+=("-e" "AWS_PROFILE=$AWS_PROFILE_STAGE")
      DOCKER_CMD+=("-e" "DEFAULT_SESSION_KUBECONFIG=$USE_SESSION_KUBECONFIG")
      DOCKER_CMD+=("-e" "MAPS_TOOLS_DAEMON_ATTACH=true")
      [ -n "${MAPS_TOOLS_BROWSER_TOKEN}" ] && DOCKER_CMD+=("-e" "MAPS_TOOLS_BROWSER_PORT=${BROWSER_LISTENER_PORT}" "-e" "MAPS_TOOLS_BROWSER_TOKEN=${MAPS_TOOLS_BROWSER_TOKEN}")
      container_start_path="$PWD"
      if echo "$container_start_path" | grep -q "$HOME"; then
        container_start_path=$(echo "$container_start_path" | sed "s|Users|home|")
      else
        container_start_path="/home/$USER"
      fi
      DOCKER_CMD+=("-e" "START_PATH=$container_start_path")
      DOCKER_CMD+=("${EXTRA_DOCKER_ARGS[@]}")
      DOCKER_CMD+=(maps-tools /usr/bin/bash --login)
    elif [ "$container_state" = "stopped" ]; then
      docker start maps-tools
      DOCKER_CMD=(docker exec -ti)
      # Only pass AWS_PROFILE if explicitly set — otherwise let bash_profile_aws
      # in the container restore the last used profile from awsctx.profile.current.
      [ -n "${AWS_PROFILE_STAGE}" ] && DOCKER_CMD+=("-e" "AWS_PROFILE=$AWS_PROFILE_STAGE")
      DOCKER_CMD+=("-e" "DEFAULT_SESSION_KUBECONFIG=$USE_SESSION_KUBECONFIG")
      DOCKER_CMD+=("-e" "MAPS_TOOLS_DAEMON_ATTACH=true")
      [ -n "${MAPS_TOOLS_BROWSER_TOKEN}" ] && DOCKER_CMD+=("-e" "MAPS_TOOLS_BROWSER_PORT=${BROWSER_LISTENER_PORT}" "-e" "MAPS_TOOLS_BROWSER_TOKEN=${MAPS_TOOLS_BROWSER_TOKEN}")
      container_start_path="$PWD"
      if echo "$container_start_path" | grep -q "$HOME"; then
        container_start_path=$(echo "$container_start_path" | sed "s|Users|home|")
      else
        container_start_path="/home/$USER"
      fi
      DOCKER_CMD+=("-e" "START_PATH=$container_start_path")
      DOCKER_CMD+=("${EXTRA_DOCKER_ARGS[@]}")
      DOCKER_CMD+=(maps-tools /init/init.sh)
    else
      echo "❌ No container named maps-tools found to attach to"
      return 1
    fi
    
  elif [ "${EXEC_IN_DAEMON}" = "true" ]; then
    if [ "$container_state" = "none" ]; then
      echo "❌ No container named maps-tools found"
      return 1
    fi
    
    if [ "$container_state" = "stopped" ]; then
      docker start maps-tools
    fi
    
    DOCKER_CMD=(docker exec -t)
    # Only pass AWS_PROFILE if explicitly set — otherwise let bash_profile_aws
    # in the container restore the last used profile from awsctx.profile.current.
    [ -n "${AWS_PROFILE_STAGE}" ] && DOCKER_CMD+=("-e" "AWS_PROFILE=$AWS_PROFILE_STAGE")
    DOCKER_CMD+=("-e" "DEFAULT_SESSION_KUBECONFIG=$USE_SESSION_KUBECONFIG")
    [ -n "${MAPS_TOOLS_BROWSER_TOKEN}" ] && DOCKER_CMD+=("-e" "MAPS_TOOLS_BROWSER_PORT=${BROWSER_LISTENER_PORT}" "-e" "MAPS_TOOLS_BROWSER_TOKEN=${MAPS_TOOLS_BROWSER_TOKEN}")
    container_start_path="$PWD"
    if echo "$container_start_path" | grep -q "$HOME"; then
      container_start_path=$(echo "$container_start_path" | sed "s|Users|home|")
    else
      container_start_path="/home/$USER"
    fi
    DOCKER_CMD+=("-e" "START_PATH=$container_start_path")
    DOCKER_CMD+=("${EXTRA_DOCKER_ARGS[@]}")
    DOCKER_CMD+=(maps-tools /usr/bin/bash --login -c "$command_to_exec")
    echo "DEBUG: Executing: ${DOCKER_CMD[*]}" >&2
    
  else
    # Standard interactive container run
    resolve_oidc_callback_ports
    DOCKER_CMD=(docker run -it --rm)
    add_volume_mounts
    add_port_mappings
    add_environment_vars
    DOCKER_CMD+=("${EXTRA_DOCKER_ARGS[@]}")
    DOCKER_CMD+=("$image_name")
  fi
}

# Validate that mutually exclusive options aren't used together
function validate_mutually_exclusive_options() {
  local active_mode_count=0
  [[ "${RUN_AS_DAEMON}" == true ]] && ((active_mode_count++))
  [[ "${ATTACH_TO_DAEMON}" == true ]] && ((active_mode_count++))
  [[ "${EXEC_IN_DAEMON}" == true ]] && ((active_mode_count++))
  
  if [[ $active_mode_count -gt 1 ]]; then
    echo "❌ Options -d, -a, and -E are mutually exclusive"
    exit 1
  fi
}

function validate_oidc_callback_options() {
  if [[ "${OIDC_CALLBACK_PORT_OVERRIDE_SET}" == true ]] && \
     { [[ "${ATTACH_TO_DAEMON}" == true ]] || [[ "${EXEC_IN_DAEMON}" == true ]]; }; then
    echo "❌ -O only applies when creating a new maps-tools container."
    echo "   Recreate the daemon container with -d -O \"${OIDC_CALLBACK_PORTS[*]}\" to change OIDC callback ports."
    exit 1
  fi
}

function run_container() {
  validate_mutually_exclusive_options
  validate_oidc_callback_options
  ensure_browser_listener
  
  # Determine image tag based on RELEASE_CHANNEL
  local image_tag="${RELEASE_CHANNEL#-}"  # Remove leading dash from RELEASE_CHANNEL
  [[ -z "$image_tag" ]] && image_tag="${DEFAULT_DOCKER_IMAGE_TAG}"
  local selected_image="${DEFAULT_DOCKER_IMAGE}:${image_tag}"

  if [ "${INTERACTIVE_IMAGE_SELECTION}" = "true" ]; then
    available_images=$(docker images --format '{{.Repository}}:{{.Tag}}' \
      | grep -E "(^|/)${DEFAULT_DOCKER_IMAGE_NAME}:" \
      | grep -v ':<none>$' \
      | sort -u || true)
    
    if [ -z "$available_images" ]; then
      echo "❌ No local images found. Run 'make build' or pull from registry"
      exit 1
    fi
    
    PS3="Choose the image to run: "
    select selected_image in $available_images; do
      if [ -n "$selected_image" ]; then
        break
      else
        echo "❌ Invalid choice"
        exit 1
      fi
    done
  fi
  
  build_docker_command "$selected_image" "$@"
  "${DOCKER_CMD[@]}"
}

# ============================================================================
# Update & Installation Functions
# ============================================================================

function download_latest_script() {
  local source_url="https://raw.githubusercontent.com/spring-media/maps-tools-install/main/maps-tools${RELEASE_CHANNEL}"
  
  # Use local copy in development context
  if [[ -f ./maps-tools && -d ./.git && -x /usr/local/bin/maps-tools ]]; then
    cp -f ./maps-tools /tmp/maps-tools || { echo "❌ Failed to copy local script"; exit 1; }
  else
    curl -sf "$source_url" >/tmp/maps-tools || { echo "❌ Failed to download from $source_url"; exit 1; }
  fi
  
  # Validate downloaded script
  [[ ! -s /tmp/maps-tools ]] && echo "❌ Downloaded script is empty" && rm -f /tmp/maps-tools && exit 1
  grep -q "#version:" /tmp/maps-tools || { echo "❌ Script corrupted (no version found)"; rm -f /tmp/maps-tools; exit 1; }
}

function install_script_to_system() {
  [[ ! -f /tmp/maps-tools ]] && echo "❌ No script found for installation" && exit 1
  
  echo "Installing maps-tools to /usr/local/bin (may require password)"
  cp -f /tmp/maps-tools /usr/local/bin/maps-tools 2>/dev/null || \
    sudo cp -f /tmp/maps-tools /usr/local/bin/maps-tools
  chmod 755 /usr/local/bin/maps-tools 2>/dev/null || \
    sudo chmod 755 /usr/local/bin/maps-tools
}

function check_docker_image_update() {
  local image_tag="${RELEASE_CHANNEL#-}"
  [[ -z "$image_tag" ]] && image_tag="${DEFAULT_DOCKER_IMAGE_TAG}"
  local full_image="${DEFAULT_DOCKER_IMAGE}:${image_tag}"
  
  if [[ "$image_tag" == "${DEFAULT_DOCKER_IMAGE_TAG}" ]]; then
    echo "Checking for Docker image updates..."
  else
    echo "Checking for Docker image updates (${image_tag})..."
  fi
  
  # Check if local image exists
  local local_image_id=$(docker images -q "${full_image}" 2>/dev/null)
  
  if [[ -z "$local_image_id" ]]; then
    echo "No local Docker image found. Pulling ${full_image}..."
    docker pull "${full_image}"
    return 0
  fi
  
  # Get remote manifest to check for updates
  echo "Checking remote registry for updates..."
  
  # Try to inspect the remote manifest
  local remote_manifest=$(docker manifest inspect "${full_image}" 2>/dev/null)
  
  if [[ -z "$remote_manifest" ]]; then
    echo "⚠️  Unable to check for Docker image updates (network or registry issue)"
    return 1
  fi
  
  # Pull the image to update (this will only download if there's a new version)
  # Show the output so users can see progress
  docker pull "${full_image}"
  return 0
}

function check_version_quick() {
  # Quick version check without downloading full script
  local current_version=$(grep -m 1 "#version:" "$0" | awk '{print $2}')
  local source_url="https://raw.githubusercontent.com/spring-media/maps-tools-install/main/maps-tools${RELEASE_CHANNEL}"
  
  # Quick fetch of just the version line (timeout after 2 seconds)
  local remote_version=$(curl -sf --max-time 2 "$source_url" 2>/dev/null | grep -m 1 "#version:" | awk '{print $2}')
  
  if [[ -n "$remote_version" && -n "$current_version" && "$remote_version" -gt "$current_version" ]]; then
    echo "📢 New maps-tools version available: v${current_version} → v${remote_version}"
    read -p "Do you want to update now? (y/n) " response
    if [[ "$response" == "y" ]]; then
      echo ""
      perform_update_and_continue
    else
      echo ""
    fi
  fi
}

function perform_update_and_continue() {
  download_latest_script
  
  local installed_version=$(grep -m 1 "#version:" /usr/local/bin/maps-tools 2>/dev/null | awk '{print $2}')
  local available_version=$(grep -m 1 "#version:" /tmp/maps-tools | awk '{print $2}')
  local script_updated=false
  
  if [[ -n "$installed_version" && -n "$available_version" && "$installed_version" -lt "$available_version" ]]; then
    echo "Upgrading maps-tools script to version ${available_version}"
    install_script_to_system
    script_updated=true
  fi
  
  rm -f /tmp/maps-tools
  
  # Check for Docker image updates
  echo ""
  check_docker_image_update
  
  if [[ "$script_updated" == true ]]; then
    echo ""
    echo "✅ Update complete! Continuing with maps-tools..."
    echo ""
  fi
}

function check_and_prompt_for_updates() {
  download_latest_script
  
  local installed_version=$(grep -m 1 "#version:" /usr/local/bin/maps-tools 2>/dev/null | awk '{print $2}')
  local available_version=$(grep -m 1 "#version:" /tmp/maps-tools | awk '{print $2}')
  local script_updated=false
  
  if [[ -n "$installed_version" && -n "$available_version" && "$installed_version" -lt "$available_version" ]]; then
    read -p "New version available ($installed_version → $available_version). Update? (y/n) " response
    if [[ "$response" == "y" ]]; then
      echo "Upgrading to version ${available_version}"
      install_script_to_system
      script_updated=true
    fi
  else
    echo "maps-tools script is up to date (v${installed_version})"
  fi
  
  rm -f /tmp/maps-tools
  
  # Always check for Docker image updates when -u is called
  echo ""
  check_docker_image_update
  
  if [[ "$script_updated" == true ]]; then
    echo ""
    echo "✅ Update complete! Run 'maps-tools' to start."
  fi
}

function pull_docker_image() {
  local image_tag="${RELEASE_CHANNEL#-}"
  [[ -z "$image_tag" ]] && image_tag="${DEFAULT_DOCKER_IMAGE_TAG}"
  docker pull "${DEFAULT_DOCKER_IMAGE}:${image_tag}"
}

# ============================================================================
# Configuration Management
# ============================================================================

function parse_optional_argument() {
  eval next_token=\${$OPTIND}
  if [[ -n $next_token && $next_token != -* ]]; then
    OPTIND=$((OPTIND + 1))
    OPTARG=$next_token
  else
    OPTARG=""
  fi
}

function backup_config_file() {
  local filepath="$1"
  [[ ! -s "$filepath" ]] && return
  local timestamp=$(date +%Y%m%d%H%M%S)
  local backup_path="${filepath}-${timestamp}"
  echo "Backing up $filepath to $backup_path"
  mv -f "$filepath" "$backup_path"
}

function backup_all_configs() {
  backup_config_file "${HOME}/.aws/config"
  backup_config_file "${HOME}/.aws/credentials"
  backup_config_file "${HOME}/.aws/awsctx"
  backup_config_file "${HOME}/.kube/config"
  
  for config_file in ${HOME}/.kube/*config-*; do
    [[ -s "$config_file" ]] || continue
    local timestamp=$(date +%Y%m%d%H%M%S)
    local filename="${config_file##*/}"
    local backup_path="${config_file%/*}/backup-${filename#*config-}-${timestamp}"
    echo "Backing up $config_file to $backup_path"
    mv -f "$config_file" "$backup_path"
  done
}

# ============================================================================
# Main Script Logic
# ============================================================================

# Use embedded RELEASE variable (set by release process) or allow CLI override
RELEASE_CHANNEL="${RELEASE:+-$RELEASE}"

# Handle development mode before getopts, because getopts does not parse long options
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --dev)
      DEV_MODE=true
      ;;
    *)
      ARGS+=("$arg")
      ;;
  esac
done
set -- "${ARGS[@]}"

# Handle version flag
[[ "$1" == "--version" ]] && echo "maps-tools version: $(grep -m 1 "#version:" "$0" | awk '{print $2}')" && exit 0

# Parse command line options
while getopts "b:o:O:he:ivdaucsxE" arg; do
  case "${arg}" in
    b) echo "🛠️  TODO: Build args not yet implemented" ;;
    e) AWS_PROFILE_STAGE="${OPTARG}" ;;
    v) MOUNT_AWS_CONFIGS=false ;;
    i) INTERACTIVE_IMAGE_SELECTION=true ;;
    d) RUN_AS_DAEMON=true ;;
    a) ATTACH_TO_DAEMON=true ;;
    E) EXEC_IN_DAEMON=true ;;
    c) PERFORM_CONFIG_CLEANUP=true ;;
    s) USE_SESSION_KUBECONFIG=true ;;
    u)
      parse_optional_argument "$@"
      RELEASE_CHANNEL="${OPTARG:+-${OPTARG}}"
      PERFORM_UPDATE=true
      ;;
    o) EXTRA_DOCKER_ARGS+=("$OPTARG") ;;
    O)
      OIDC_CALLBACK_PORT_CANDIDATES="${OPTARG}"
      OIDC_CALLBACK_PORT_OVERRIDE_SET=true
      ;;
    x) ENABLE_K8S_DASHBOARD=true ;;
    h|?|*) print_usage ;;
  esac
done
shift $((OPTIND - 1))

# Handle initial installation
if [[ "${DEV_MODE}" != true && ! -x /usr/local/bin/maps-tools ]]; then
  echo "Installing maps-tools to /usr/local/bin"
  download_latest_script
  install_script_to_system
  rm -f /tmp/maps-tools
  
  cat <<EOF

Add /usr/local/bin to your \$PATH:

bash:  echo 'export PATH="/usr/local/bin:\$PATH"' >> ~/.bashrc && source ~/.bashrc
zsh:   echo 'export PATH="/usr/local/bin:\$PATH"' >> ~/.zshrc && source ~/.zshrc

EOF
  exit 0
fi

# Handle update request
if [[ "$PERFORM_UPDATE" == true ]] || [[ "${0##*/}" != "maps-tools" ]]; then
  check_and_prompt_for_updates
  exit 0
fi

# Handle config cleanup
if [[ "$PERFORM_CONFIG_CLEANUP" == true ]]; then
  read -p "Are you sure you want to backup and cleanup .aws and .kube configs? (y/n) " response
  [[ "$response" == [Yy]* ]] && backup_all_configs || echo "Cleanup cancelled"
  exit 0
fi

# Verify Docker installation
if [[ ! -d "/Applications/Rancher Desktop.app" && ! -d "/Applications/Docker.app" ]]; then
  echo "⚠️  Warning: Rancher Desktop or Docker Desktop not found (officially supported)"
fi

# Start Docker if needed
function is_docker_running() {
  lsof -U 2>/dev/null | grep -q docker.sock
}

if is_docker_running; then
  echo "Docker is running"
  DOCKER_IS_RUNNING=true
else
  # Try to start Docker
  if [[ -e "/Applications/Rancher Desktop.app" ]]; then
    echo "Starting Rancher Desktop (use dockerd runtime, not containerd)"
    open "/Applications/Rancher Desktop.app"
  elif [[ -e "/Applications/Docker.app" ]]; then
    echo "Starting Docker Desktop"
    open "/Applications/Docker.app"
  fi
  
  # Wait for Docker to start (up to 4 minutes)
  echo -n "Waiting for Docker"
  for ((attempt=0; attempt<48; attempt++)); do
    sleep 5
    echo -n "."
    if is_docker_running; then
      echo
      echo "Docker started successfully"
      DOCKER_IS_RUNNING=true
      sleep 5
      break
    fi
  done
  
  if [[ "$DOCKER_IS_RUNNING" != true ]]; then
    echo
    echo "❌ Failed to start Docker within timeout"
    exit 1
  fi
fi

# Run the Docker container
if [[ "$DOCKER_IS_RUNNING" == true ]]; then
  echo "🚀 maps-tools v$(grep -m 1 "#version:" "$0" | awk '{print $2}')"
  
  # Quick version check on normal runs (not for attach/daemon operations)
  if [[ "${ATTACH_TO_DAEMON}" != true && "${RUN_AS_DAEMON}" != true && "${EXEC_IN_DAEMON}" != true ]]; then
    check_version_quick
  fi
  
  run_container "$@"
fi
