# ============================================================================
# Constants
# ============================================================================
readonly DEFAULT_DOCKER_IMAGE_REGISTRY="ghcr.io/spring-media"
readonly DEFAULT_DOCKER_IMAGE_NAME=maps-tools
readonly DEFAULT_DOCKER_IMAGE_TAG=latest
readonly DEFAULT_DOCKER_USERNAME=k8s
readonly DEFAULT_DOCKER_IMAGE="${DEFAULT_DOCKER_IMAGE_REGISTRY}/${DEFAULT_DOCKER_IMAGE_NAME}"

# ============================================================================
# Global Variables
# ============================================================================
INTERACTIVE_IMAGE_SELECTION=false
AWS_PROFILE_STAGE=$AWS_PROFILE
MOUNT_AWS_CONFIGS=true
RUN_AS_DAEMON=false
ATTACH_TO_DAEMON=false
EXEC_IN_DAEMON=false
PERFORM_UPDATE=false
PERFORM_CONFIG_CLEANUP=false
USE_SESSION_KUBECONFIG=false
ENABLE_K8S_DASHBOARD=false
RELEASE=testing
CURRENT_USER=${HOME##*/}
DOCKER_IS_RUNNING=false
OIDC_CALLBACK_PORT_CANDIDATES="${MAPS_TOOLS_OIDC_CALLBACK_PORTS:-}"
OIDC_CALLBACK_PORT_OVERRIDE_SET=false
DEV_MODE=false

declare -a EXTRA_DOCKER_ARGS
declare -a AVAILABLE_PORTS
declare -a OIDC_CALLBACK_PORTS
declare -a OIDC_LISTEN_ADDRESSES

function is_port_available() {
  local port="$1"
  ! nc -z 127.0.0.1 "${port}" -w2 2>/dev/null
}

# ============================================================================
# Browser Listener (opens OIDC login URLs on the host)
# ============================================================================

BROWSER_LISTENER_PORT=19000
BROWSER_LISTENER_TOKEN_FILE="${HOME}/.maps-tools/browser-listener.token"
BROWSER_LISTENER_PID_FILE="${HOME}/.maps-tools/browser-listener.pid"
MAPS_TOOLS_BROWSER_TOKEN=""

function ensure_browser_listener() {
  # Only run on macOS (uses `open` to launch browser)
  [[ "$(uname)" != "Darwin" ]] && return 0

  # Ensure ~/.maps-tools dir exists
  mkdir -p "${HOME}/.maps-tools"

  # Check if listener is already running on port 19000
  if ! is_port_available "${BROWSER_LISTENER_PORT}"; then
    # Already running — read existing token
    if [ -f "${BROWSER_LISTENER_TOKEN_FILE}" ]; then
      MAPS_TOOLS_BROWSER_TOKEN="$(cat "${BROWSER_LISTENER_TOKEN_FILE}")"
      return 0
    fi
  fi

  # Generate new token
  MAPS_TOOLS_BROWSER_TOKEN="$(/usr/bin/python3 -c "import secrets; print(secrets.token_hex(32))")"
  echo "${MAPS_TOOLS_BROWSER_TOKEN}" > "${BROWSER_LISTENER_TOKEN_FILE}"
  chmod 600 "${BROWSER_LISTENER_TOKEN_FILE}"

  # Start inline Python listener — no external script file needed.
  # Wrapped in a subshell so the heredoc works correctly with backgrounding.
  local _token="${MAPS_TOOLS_BROWSER_TOKEN}"
  local _port="${BROWSER_LISTENER_PORT}"
  local _log="${HOME}/.maps-tools/browser-listener.log"
  ( /usr/bin/python3 - "${_token}" "${_port}" >"${_log}" 2>&1 <<'BROWSER_LISTENER_PYTHON'
import http.server
import subprocess
import sys
import urllib.parse
from datetime import datetime

token = sys.argv[1]
port  = int(sys.argv[2])

def log(msg):
    print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] [maps-tools] {msg}", flush=True)

class BrowserHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        if params.get("token", [""])[0] != token:
            log("Rejected request with invalid token")
            self.send_response(403)
            self.end_headers()
            self.wfile.write(b"Forbidden\n")
            return
        urls = params.get("url", [])
        if not urls:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b"Missing url parameter\n")
            return
        log(f"Opening in browser: {urls[0]}")
        subprocess.Popen(["open", urls[0]])
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"OK\n")
    def log_message(self, *a):
        pass

log(f"Browser listener ready on port {port}")
http.server.HTTPServer(("127.0.0.1", port), BrowserHandler).serve_forever()
BROWSER_LISTENER_PYTHON
  ) &
  echo $! > "${BROWSER_LISTENER_PID_FILE}"

  echo "Host browser listener started on port ${BROWSER_LISTENER_PORT}"
}

# ============================================================================
# Initialization
# ============================================================================

# Find 5 available ports in range 8000-8999
for port in {8000..8999}; do
  is_port_available "${port}" || continue
  AVAILABLE_PORTS+=("${port}")
  [ "${#AVAILABLE_PORTS[@]}" -eq 5 ] && break
  [ "${port}" -eq 8999 ] && echo "All local ports 8000-8999 are in use" && exit 1
done

